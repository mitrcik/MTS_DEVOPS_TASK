{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["activeSlot", "releaseId"],
  "properties": {
    "activeSlot": {"type": "string", "enum": ["blue", "green"]},
    "releaseId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"},
    "ingressClassName": {"type": "string"}
  }
}
