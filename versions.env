# Единый источник закреплённых версий рантайма и образов (KEY=VALUE, читается Make,
# bash-скриптами и Ansible). CLI-инструменты с URL и SHA-256 — infra/tools/tools.yml.
#
# Правило выбора (зафиксировано 2026-10-15, см. docs/decisions.md): последний стабильный
# выпуск, опубликованный не позже 2026-10-01 (без RC и релизов «нулевого дня»).

# Кластер
K3S_IMAGE=docker.io/rancher/k3s:v1.36.5-k3s1
REGISTRY_IMAGE=docker.io/library/registry:3.1.2

# Приложение: Python 3.13 на Alpine 3.24 (минимальная база: ~29 МБ, меньше пакетов и CVE,
# чем у Debian slim — сравнение в docs/decisions.md D7). Патчи базы приходят через --pull.
PYTHON_IMAGE=docker.io/library/python:3.13-alpine3.24

# Наблюдаемость (собственный чарт observability/, образы с Docker Hub)
PROMETHEUS_IMAGE=docker.io/prom/prometheus:v3.13.4
ALERTMANAGER_IMAGE=docker.io/prom/alertmanager:v0.34.1
GRAFANA_IMAGE=docker.io/grafana/grafana:13.2.3
BLACKBOX_IMAGE=docker.io/prom/blackbox-exporter:v0.28.0

# Вспомогательные проверки (запускаются в контейнерах)
SHELLCHECK_IMAGE=docker.io/koalaman/shellcheck:v0.11.0
BUSYBOX_IMAGE=docker.io/library/busybox:1.37
