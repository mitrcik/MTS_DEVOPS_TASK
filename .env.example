# Локальные настройки стенда. `make up` копирует этот файл в .env (игнорируется Git),
# если .env ещё нет. Синтаксис bash: значения с пробелами — в двойных кавычках.
# Секретов здесь нет и быть не должно.

# Имя k3d-кластера; от него производны имена registry, kubeconfig и age-ключа.
CLUSTER_NAME=mts-devops
# Все порты публикуются только на loopback.
BIND_ADDRESS=127.0.0.1
INGRESS_PORT=8080
API_PORT=6550
REGISTRY_PORT=5001

# Версия, которую `make up` собирает и выкатывает первой.
INITIAL_VERSION=v1

# Post-deploy gate (демо-профиль: короткое окно, чтобы демонстрация укладывалась в минуты).
POST_DEPLOY_WINDOW_SECONDS=30
LOAD_RPS=8
MIN_HTTP_REQUESTS=120
MIN_METRIC_REQUESTS=60
MAX_ERROR_RATIO=0.02
MAX_P95_SECONDS=0.5
# Сколько ждать занятую блокировку стенда (0 — сразу завершиться с понятной ошибкой).
LOCK_WAIT_SECONDS=0

# --- Необязательные параметры для особых сетей (по умолчанию пусто) ---
# Зеркало Docker Hub для узлов k3s (например https://mirror.gcr.io) при лимитах 429/блокировках.
# Для сборки на хосте зеркало настраивается в /etc/docker/daemon.json (docs/troubleshooting.md).
DOCKERHUB_MIRROR=
# Полный CA-бандл (системные CA + CA корпоративного TLS-прокси). Используется в сборке образа
# (BuildKit secret) и монтируется в узел k3s.
EXTRA_CA_BUNDLE=
# Дополнительные аргументы `k3d cluster create` (особые окружения; см. troubleshooting).
K3D_EXTRA_ARGS=
